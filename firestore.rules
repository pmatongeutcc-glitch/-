rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserData(data, userId) {
      return data.uid is string &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.data is string &&
        data.data.size() <= 2097152 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 64 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserData(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserData(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
